# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary build with embedded frontend
/artex
# One-click update artifacts beside the executable (staged files, backups, failed versions, update markers)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime in the project root; never commit)
/jwt.key

# Local Docker deployment environment (contains passwords/keys; do not commit)
.env

# Scheduler runtime/simulation event logs (test artifacts; do not commit)
*-events.csv

# Benchmark artifacts (local only; do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- artex-global local operations: do not commit (owner instruction: keep test/scan results private) ---
work/
test-results/
scan-output/
evidence-local/
# Runtime data from running the demo app locally (recorded proxy traffic index database,
# mitmproxy CA private key, etc.) must not be committed to the public repository (BRIEF boundary #2).
/demo-data/
*.local.env
# D2 live model comparison tests reside inside package agent rather than work/.
# These local-only artifacts use OPENROUTER_API_KEY and the network; do not commit them
# to the public repository (BRIEF boundary #2). Ignore exact paths to preserve tracked upstream tests.
agent/d2_models_live_test.go

# API keys and secrets: never commit, regardless of location
*.env
secrets.env

# --- Local Windows source build artifacts: do not commit ---
# Windows single binary from go build -o artex.exe (counterpart to Unix /artex)
/artex.exe
# Secrets in local configuration (e.g. PostgreSQL passwords). Never commit.
/.secrets/
# Codex credentials for local/Compose use (never commit).
**/auth.json
# Native binding cache when SWC_NATIVE_BINDING_CACHE points inside the project
/.swc-cache/
# Redirected runtime logs from running artex.exe in the foreground
/artex.out.log
/artex.err.log
