# Docker deployment settings (copy this file to .env)
# Compose uses the locally built artex:local image. See README.md for build steps.
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (set either or both; you can leave these blank and configure them later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional Codex ChatGPT login: paste the COMPLETE content of auth.json between
# single quotes (multiline JSON is supported). Do not paste it into chat or Git.
# Example layout (replace the JSON with your actual file, including all fields):
# ARTEX_CODEX_AUTH_JSON='{
#   "auth_mode": "chatgpt",
#   "tokens": { ...all fields from your auth.json... }
# }'
# Set ARTEX_LLM_PROVIDER=codex and ARTEX_LLM_MODEL above, or configure the UI.
# Refreshed credentials persist in ./data/codex; unchanged input is not reapplied.
ARTEX_CODEX_AUTH_JSON=

# Alternative Codex authentication: personal access token with Codex scope.
# Set only one of CODEX_ACCESS_TOKEN and ARTEX_CODEX_AUTH_JSON.
# Example: CODEX_ACCESS_TOKEN='at-your-personal-access-token'
# Imported into ./data/codex/auth.json; removed from ARTEX's process environment.
CODEX_ACCESS_TOKEN=

# First-run protection (prevents remote takeover of the administrator account)
# - The web/API port is published only on host address 127.0.0.1 by default. To allow direct
#   access from other devices, set ARTEX_BIND=0.0.0.0 after completing initial setup.
# - On first startup, a random setup token appears in the logs (docker compose logs artex).
#   Enter it at /setup to create the administrator password.
#   If ARTEX_SETUP_TOKEN is set, its value is used and is not printed in the logs.
# - Setting ARTEX_ADMIN_PASSWORD initializes the password directly without /setup (at least 8 characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist, comma-separated. Leave blank for the same-origin embedded UI.
ARTEX_CORS_ORIGINS=

# Default server output language (en, ko, zh, es, ja). Defaults to English when empty.
# - Sets the default for agent reports, summaries, conversation replies, and server error messages.
#   The Display Language selection in Settings takes precedence.
# - Server console logs follow only this value, regardless of the Settings selection.
# - Each browser selects its UI language in Settings (English by default).
ARTEX_LANG=
